# ==============================================================================
# Campus Mart - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Java Backend Configuration
# ------------------------------------------------------------------------------
# Server Port
PORT=8080

# Supabase PostgreSQL Database Credentials
# You can find these in your Supabase project settings -> Database -> Connection string -> JDBC / URI:
# e.g., jdbc:postgresql://db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require
# Or via Transaction Pooler:
# e.g., jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD

# JWT Secret (must be at least 32 characters / 256 bits)
JWT_SECRET=campusmartsupersecretjwtkeycampusmartsupersecretjwtkey2026

# JWT Expiration Time in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Directory for storing uploaded listing images locally
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 2. React + TypeScript Frontend Configuration
# ------------------------------------------------------------------------------
# Java REST Backend API Base URL
VITE_API_URL=http://localhost:8080/api

# (Optional) Supabase Client Keys - only needed if you use Supabase client directly
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
